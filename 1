</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;halfPriceOffer&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Offer&quot;},&quot;showPlans&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Sections&quot;},&quot;accent&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#33523f&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;options&quot;:[&quot;#33523f&quot;,&quot;#3d4f6b&quot;,&quot;#6b3f3a&quot;,&quot;#4a4534&quot;],&quot;section&quot;:&quot;Look&quot;}}">
class Component extends DCLogic {
  state = {
    step: 1,
    rel: 'My mother', age: '', city: 'Monrovia', mobility: 'Walks on their own', gender: 'A woman',
    days: [], hours: 'About 6 a week — Dawat', need: '', before: 'No, this is our first time',
    name: '', phone: '', email: '', when: 'Afternoons', heard: 'From the masjid', lang: 'Urdu',
    touched: false, done: false, sentPhone: '', sentName: '', sentWhen: ''
  };

  set(k) { return (e) => this.setState({ [k]: e.target.value }); }

  toggleDay(d) {
    const on = this.state.days.includes(d);
    this.setState({ days: on ? this.state.days.filter(x => x !== d) : this.state.days.concat(d) });
  }

  renderVals() {
    const s = this.state;
    const green = this.props.accent || '#33523f';
    const dim = 'var(--color-divider)';
    const okName = s.name.trim().length > 1;
    const okPhone = s.phone.replace(/\D/g, '').length >= 10;

    const dayNames = ['Jummah', 'Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'];

    return {
      isStep1: !s.done && s.step === 1,
      isStep2: !s.done && s.step === 2,
      isStep3: !s.done && s.step === 3,
      isDone: s.done,
      stepLabel: s.done ? 'Done' : 'Step ' + s.step + ' of 3',
      bar1: s.step >= 1 || s.done ? green : dim,
      bar2: s.step >= 2 || s.done ? green : dim,
      bar3: s.step >= 3 || s.done ? green : dim,

      rel: s.rel, age: s.age, city: s.city, mobility: s.mobility,
      onRel: this.set('rel'), onAge: this.set('age'), onCity: this.set('city'), onMobility: this.set('mobility'),
      liftWarning: s.mobility === 'Uses a wheelchair, needs help transferring',

      gW: s.gender === 'A woman', gM: s.gender === 'A man', gA: s.gender === 'No preference',
      pickW: () => this.setState({ gender: 'A woman' }),
      pickM: () => this.setState({ gender: 'A man' }),
      pickA: () => this.setState({ gender: 'No preference' }),

      days: dayNames.map(d => {
        const on = s.days.includes(d);
        return {
          label: d, toggle: () => this.toggleDay(d),
          bg: on ? green : 'transparent',
          fg: on ? '#fcfbfa' : 'var(--color-text)',
          border: on ? green : 'color-mix(in srgb, var(--color-divider) 80%, transparent)'
        };
      }),

      hours: s.hours, need: s.need, before: s.before,
      onHours: this.set('hours'), onNeed: this.set('need'), onBefore: this.set('before'),

      name: s.name, phone: s.phone, email: s.email, when: s.when, heard: s.heard,
      onName: this.set('name'), onPhone: this.set('phone'), onEmail: this.set('email'),
      onWhen: this.set('when'), onHeard: this.set('heard'),

      lU: s.lang === 'Urdu', lE: s.lang === 'English', lM: s.lang === 'Memoni', lAny: s.lang === 'Either',
      pickU: () => this.setState({ lang: 'Urdu' }),
      pickE: () => this.setState({ lang: 'English' }),
      pickMem: () => this.setState({ lang: 'Memoni' }),
      pickAny: () => this.setState({ lang: 'Either' }),

      errName: s.touched && !okName,
      errPhone: s.touched && !okPhone,

      next: () => this.setState({ step: Math.min(3, s.step + 1) }),
      back: () => this.setState({ step: Math.max(1, s.step - 1) }),

      submit: (e) => {
        e.preventDefault();
        if (!okName || !okPhone) { this.setState({ touched: true }); return; }
        this.setState({ done: true, touched: false, sentPhone: s.phone, sentName: s.name, sentWhen: s.when });
      },
      restart: () => this.setState({ step: 1, done: false, name: '', phone: '', email: '', need: '', days: [] }),

      thanks: s.sentName ? 'Thank you, ' + s.sentName.trim().split(' ')[0] + '.' : 'Thank you.',
      shownPhone: s.sentPhone,
      shownWhen: (s.sentWhen || 'Any time').toLowerCase()
    };
  }
}
</script>
</body>
</html>
